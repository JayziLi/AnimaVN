# Copy to .env.local only if the backend is somewhere unusual.
# Unset (the default), the frontend calls http://<the hostname in the address bar>:8000,
# so phones on the LAN / Tailscale reach the backend without changing anything.
# Setting localhost here breaks that: a phone would call its own localhost.
# An empty value means same origin (behind nginx).
# VITE_API_BASE_URL=http://localhost:8000

# Test builds only (database copy, test ports): a red badge in the top-left corner
# so nobody mistakes the page for the real one. Leave unset in production.
# VITE_ENV_LABEL=测试版 · 库副本
