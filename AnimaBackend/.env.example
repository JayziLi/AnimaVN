# Copy to .env and fill in what you have. Everything is optional.

# Only read on the first startup, to seed default connections; after that,
# connections live in the DB and are managed in the console (连接).
# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI or any OpenAI-compatible endpoint (OpenAI, OpenRouter, local Ollama, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Jev (labels sprites / scenes for the LLM). Overrides the key typed into the
# plugin page; handy on a server.
# JEV_API_KEY=

# Emotion model for sprite-tag fallback matching. Download it with
#   python scripts/download_emotion_model.py
# Default: AnimaBackend/models/bge-small-zh-v1.5
# EMOTION_MODEL_DIR=

# CORS. Defaults allow the Vite dev server on localhost / LAN / Tailscale (:5173).
# Set CORS_ORIGIN_REGEX to an empty value when deploying behind nginx (same origin).
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# CORS_ORIGIN_REGEX=

# Optional. Default is anchored to AnimaBackend/data/animabackend.db regardless
# of the directory uvicorn is launched from — only override if you must.
# DATABASE_URL=sqlite:///./data/animabackend.db
